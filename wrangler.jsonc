{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "snack-signup-bot",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-10",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["* * * * *"] },
  "assets": {
    "directory": "./build",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "snack-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "env": {
    "test": {
      "name": "snack-signup-bot-test",
      "workers_dev": true,
      "preview_urls": false,
      "triggers": { "crons": ["* * * * *"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "snack-signup-test",
          "database_id": "cf436dc5-1d38-4f8a-9968-8c0461bbed8c",
          "migrations_dir": "migrations",
        },
      ],
    },
  },
}
