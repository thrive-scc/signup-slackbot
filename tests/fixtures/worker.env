# Synthetic keys for disposable tests only. Explicit env-file excludes local secrets.
SLACK_SIGNING_SECRET=fixture-slack-signing-secret
CALENDAR_SIGNING_KEY=fixture-calendar-signing-secret
PUBLIC_ORIGIN=http://127.0.0.1:8788
# Browser tests queue delivery without ever contacting Slack.
SLACK_BOT_TOKEN=
SLACK_BOT_WORKSPACE_ID=
