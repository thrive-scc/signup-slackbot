{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "@cloudflare/vitest-plugin/types"]
  },
  "include": [
    "worker/**/*.ts",
    "tests/**/*.ts",
    "*.config.ts",
    "worker-configuration.d.ts"
  ]
}
