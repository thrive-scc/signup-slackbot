{
  "name": "snack-signup-bot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names worker,ui \"npm:dev:worker\" \"npm:dev:ui\"",
    "dev:worker": "wrangler dev worker/local.ts --local --ip 0.0.0.0 --port 8787 --persist-to /state/dev --test-scheduled",
    "dev:ui": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --persist-to /state/dev",
    "db:seed:local": "wrangler d1 execute DB --local --persist-to /state/dev --file tests/fixtures/life-groups.sql",
    "db:setup:local": "npm run db:migrate:local && npm run db:seed:local",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "types": "wrangler types && svelte-kit sync",
    "check": "npm run types && svelte-check --tsconfig ./tsconfig.json && tsc --project tsconfig.worker.json --noEmit",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "npm run build && playwright test",
    "build": "vite build && wrangler deploy --dry-run --outdir dist",
    "verify": "npm run format:check && npm run lint && npm run check && npm run test:unit && npm run build && npm run test:integration && playwright test",
    "setup:demo": "node scripts/setup-demo.mjs",
    "demo:signup": "node --env-file=.dev.vars scripts/demo-signup.mjs",
    "demo:command": "node --env-file=.dev.vars scripts/demo-command.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.7",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/node": "24.13.4",
    "concurrently": "10.0.5",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.23.0",
    "ical.js": "2.2.1",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "4.1.11",
    "wrangler": "4.131.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260910.1": true
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1"
  }
}
